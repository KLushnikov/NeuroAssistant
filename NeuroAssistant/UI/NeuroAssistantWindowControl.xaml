<UserControl x:Class="NeuroAssistant.UI.NeuroAssistantWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:core="clr-namespace:NeuroAssistant.Core"
             xmlns:ui="clr-namespace:NeuroAssistant.UI"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300"
             Name="NeuroAssistantWindow">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
            <Setter Property="Margin"
                    Value="0,5,0,3" />
        </Style>

        <Style TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBackgroundKey}}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBorderKey}}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding"
                    Value="5" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ButtonTextKey}}" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Grid.Column="2"
                                          Focusable="false"
                                          Background="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,5" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid  Name="DropDown"
                                       SnapsToDevicePixels="True"
                                       MinWidth="{TemplateBinding ActualWidth}"
                                       MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}" />
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}" />
                </Trigger>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="5,5,5,0">
            <ComboBox DockPanel.Dock="Left"
                      Width="200"
                      ItemsSource="{Binding AiProfileNames}"
                      SelectedItem="{Binding AiProfileNameSelected}" />

            <Button HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Background="{DynamicResource {x:Static SystemColors.GrayTextColor}}"
                    BorderThickness="0"
                    Command="{Binding SwitchShowSettingCommand}">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Padding="0"
                           Margin="0"
                           Text="&#xE713;"
                           FontSize="16" />
            </Button>
        </DockPanel>

        <Grid Grid.Row="1"
              x:Name="AiMessageGrid"
              Visibility="{Binding AiMessageGridVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="160"/>
                <RowDefinition Height="3" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="5,5,5,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding AiMessage}">
                    <TextBox.InputBindings>
                        <KeyBinding Command="{Binding SendToAiCommand}"
                                    Key="Enter"
                                    Modifiers="Ctrl" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Row="1"
                        Height="30"
                        VerticalAlignment="Top"
                        Content="Send"
                        Command="{Binding SendToAiCommand}" />
            </Grid>
            
            <GridSplitter Grid.Row="1"
                          Margin="5,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#cccccc"
                          ShowsPreview="True" />

            <TextBox Grid.Row="2"
                     Margin="5,3,5,5"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding AiResultContent}" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="5"
              x:Name="SettingGrid"
              Visibility="{Binding SettingGridVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Profile name" />
                <TextBox Text="{Binding AiProfileSelected.ProfileName}" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Url" />
                <TextBox Text="{Binding AiProfileSelected.EndpointUrl}" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Api key" />
                <TextBox Text="{Binding AiProfileSelected.ApiKey}" />
            </StackPanel>

            <StackPanel Grid.Row="3">
                <TextBlock Text="Model" />
                <TextBox Text="{Binding AiProfileSelected.Model}" />
            </StackPanel>

            <StackPanel Grid.Row="4">
                <TextBlock Text="Temperature" />
                <TextBox Text="{Binding AiProfileSelected.Temperature}" />
            </StackPanel>

            <StackPanel Grid.Row="5">
                <TextBlock Text="Max tokens" />
                <TextBox Text="{Binding AiProfileSelected.MaxTokens}" />
            </StackPanel>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Button HorizontalAlignment="Right"
                        Grid.Column="1"
                        Margin="3"
                        Content="Save"
                        Width="70"
                        VerticalContentAlignment="Center"
                        Command="{Binding SaveSettingCommand}" />

                <Button HorizontalAlignment="Right"
                        Grid.Column="2"
                        Margin="3"
                        Width="70"
                        Content="Cancel"
                        Command="{Binding CancelSettingCommand}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
